{
  "format": 1,
  "id": "product-design-engineering",
  "version": "1.1.0",
  "title": "メカニカル製品の開発",
  "purpose": "腕時計や自動車のように機構と外装を持つ組立製品を、企画から設計・試作検証・調達・生産準備・量産と振り返りまで、ゲートで判定しながら進める。要求から3Dモデル・図面・解析・試験・工程の管理までを項目の引用でつなぐ。",
  "phases": [
    {
      "id": "process",
      "name": "進め方",
      "purpose": "対象の製品、通る工程と省く工程、ゲートの判定者と判定の物差し、段階の分け方、AIに頼む範囲、成果物の置き場と版の固め方を決める。",
      "after": [],
      "deliverables": [
        "process-map"
      ],
      "acceptance": [
        "process.complete",
        "process.approved"
      ]
    },
    {
      "id": "planning",
      "name": "製品企画",
      "purpose": "誰が何のために使う製品かを決め、市場・法規・事業の前提から、目標値と優先度のある要求に落とす。",
      "after": [
        "process"
      ],
      "deliverables": [
        "product-plan",
        "requirement-list"
      ],
      "acceptance": [
        "planning.complete",
        "planning.requirements-measurable",
        "planning.approved"
      ]
    },
    {
      "id": "concept",
      "name": "コンセプト設計",
      "purpose": "機構の方式と外装の方向を複数案で比べて一つに絞り、動かせない寸法と位置（ハードポイント）と、先に潰すリスクを決める。",
      "after": [
        "planning"
      ],
      "deliverables": [
        "concept-study",
        "hard-points",
        "risk-register"
      ],
      "acceptance": [
        "concept.alternatives",
        "concept.hard-points",
        "concept.risks",
        "concept.approved"
      ]
    },
    {
      "id": "system-design",
      "name": "基本設計",
      "purpose": "製品を部分と部品に分けてつなぎ目を決め、配置の3Dモデルで空間・可動範囲を確かめ、質量・原価・公差を割り付け、工法と調達の方針と設計の故障モードを決める。",
      "after": [
        "concept"
      ],
      "deliverables": [
        "architecture",
        "layout-model",
        "budget",
        "ebom",
        "dfmea",
        "sourcing-plan"
      ],
      "acceptance": [
        "system-design.architecture",
        "system-design.layout",
        "system-design.budget",
        "system-design.ebom",
        "system-design.dfmea",
        "system-design.sourcing",
        "system-design.approved"
      ]
    },
    {
      "id": "detail-design",
      "name": "詳細設計",
      "purpose": "各部品を、作れて検査できる形まで決める。詳細の3Dモデル・図面・重要特性・解析・面品質と意匠・製造性の確認をそろえ、試作に出せる版を出図する。",
      "after": [
        "system-design"
      ],
      "deliverables": [
        "detail-model",
        "drawings",
        "key-characteristics",
        "analysis-report",
        "appearance-review",
        "dfm-review"
      ],
      "acceptance": [
        "detail-design.model",
        "detail-design.drawings",
        "detail-design.key-characteristics",
        "detail-design.analysis",
        "detail-design.appearance",
        "detail-design.appearance-approved",
        "detail-design.dfm",
        "detail-design.approved"
      ]
    },
    {
      "id": "design-verification",
      "name": "試作・設計検証",
      "purpose": "出図した版で試作し、要求を満たすことを実物の試験で確かめる。解析との差を説明し、量産型に進んでよいかを決める。",
      "after": [
        "detail-design"
      ],
      "deliverables": [
        "dv-plan",
        "dv-report"
      ],
      "acceptance": [
        "design-verification.plan",
        "design-verification.results",
        "design-verification.approved"
      ]
    },
    {
      "id": "sourcing",
      "name": "調達・取引先開発",
      "purpose": "部品ごとに、品質・原価・納期を守って続けて納められる取引先を決め、型と治具を発注し、取引先の初物を承認する。",
      "after": [
        "detail-design"
      ],
      "deliverables": [
        "quote-comparison",
        "part-approval"
      ],
      "acceptance": [
        "sourcing.quotes",
        "sourcing.approvals",
        "sourcing.approved"
      ]
    },
    {
      "id": "process-design",
      "name": "生産準備",
      "purpose": "決めたタクトと品質で作れる工程を用意する。工程の流れ、工程の故障モード、管理の計画、作業標準、治具・検査具・設備をそろえる。",
      "after": [
        "detail-design"
      ],
      "deliverables": [
        "process-flow",
        "control-plan"
      ],
      "acceptance": [
        "process-design.flow",
        "process-design.control",
        "process-design.approved"
      ]
    },
    {
      "id": "production-validation",
      "name": "量産試作・工程検証",
      "purpose": "量産の型・工程・作業者で作ったものが要求を満たし続けることを、工程能力と量産品の試験と認証で確かめ、量産に移ってよいかを決める。",
      "after": [
        "design-verification",
        "sourcing",
        "process-design"
      ],
      "deliverables": [
        "pv-report"
      ],
      "acceptance": [
        "production-validation.capability",
        "production-validation.certified",
        "production-validation.approved"
      ]
    },
    {
      "id": "launch",
      "name": "量産立上げ",
      "purpose": "量産を始め、初期の変動を管理を厚くして抑え込み、取扱説明・整備の文書とサービス部品を出す。",
      "after": [
        "production-validation"
      ],
      "deliverables": [
        "launch-record"
      ],
      "acceptance": [
        "launch.complete",
        "launch.approved"
      ]
    },
    {
      "id": "sustain",
      "name": "量産・振り返り",
      "purpose": "量産中の変更と市場の品質を管理し、学びを次の製品と工程の定義に戻す。",
      "after": [
        "launch"
      ],
      "deliverables": [
        "learning-record"
      ],
      "acceptance": [
        "sustain.complete",
        "sustain.approved"
      ]
    }
  ],
  "sections": [
    {
      "id": "plan",
      "name": "企画",
      "icon": "lightbulb",
      "phases": [
        "process",
        "planning"
      ]
    },
    {
      "id": "design",
      "name": "設計",
      "icon": "ruler",
      "phases": [
        "concept",
        "system-design",
        "detail-design"
      ]
    },
    {
      "id": "verify",
      "name": "設計検証",
      "icon": "flask-conical",
      "phases": [
        "design-verification"
      ]
    },
    {
      "id": "industrialize",
      "name": "調達と生産準備",
      "icon": "truck",
      "phases": [
        "sourcing",
        "process-design",
        "production-validation"
      ]
    },
    {
      "id": "produce",
      "name": "量産",
      "icon": "factory",
      "phases": [
        "launch",
        "sustain"
      ]
    }
  ],
  "deliverables": [
    {
      "id": "process-map",
      "name": "工程計画",
      "form": "文書",
      "outline": [
        {
          "heading": "対象と出口",
          "describe": "対象の製品（機構と外装の範囲、電子・ソフトを含むか）、どの工程まで進めるか、出口で使える状態"
        },
        {
          "heading": "工程の取捨",
          "describe": "通る工程・省く工程と理由、省いたときの代わりの確かめ方。製品の種類に合わせて深さを変えるところ"
        },
        {
          "heading": "ゲート",
          "describe": "各工程の終わりのゲートごとに、判定者、判定の物差し（数値と単位、比べる画像）、通過・条件付き通過・差戻しの扱い",
          "item": "gate"
        },
        {
          "heading": "段階と受入",
          "describe": "大きな工程を小さな段階に分ける方針、まとめて受け入れる区切り、受け入れた版の固め方"
        },
        {
          "heading": "AIに頼む範囲",
          "describe": "調査・設計案・形状の作成・解析・確認のそれぞれで、AIが提案できること、人が決めること、使う道具と断られたときの代わり"
        },
        {
          "heading": "置き場と版",
          "describe": "成果物と3Dモデル・図面・解析結果の置き場、版の付け方、ゲートを通った版を固めたあとの変更の扱い"
        }
      ]
    },
    {
      "id": "product-plan",
      "name": "企画書",
      "form": "文書",
      "uses": [
        "process-map"
      ],
      "outline": [
        {
          "heading": "製品の狙い",
          "describe": "一文の製品の説明、誰に何を届けるか、他と区別する点"
        },
        {
          "heading": "使われ方",
          "describe": "使う人・場面・頻度・環境（温度・水・衝撃など）。一つずつ",
          "item": "use-case"
        },
        {
          "heading": "比べる製品",
          "describe": "比べる既存の製品と、その寸法・性能・価格など比べる数値。出典",
          "item": "benchmark"
        },
        {
          "heading": "法規と規格",
          "describe": "守る法規・規格と、適用する条項・試験。一つずつ",
          "item": "regulation"
        },
        {
          "heading": "事業の前提",
          "describe": "目標の価格と原価、年間の数量と生産する年数、発売の時期、投資の上限"
        }
      ]
    },
    {
      "id": "requirement-list",
      "name": "要求一覧",
      "form": "表",
      "uses": [
        "product-plan"
      ],
      "outline": [
        {
          "heading": "要求",
          "describe": "一行に一つの要求。区分（機能・性能・意匠・法規・原価・質量・製造）、内容、目標値と単位、優先度（必須・目標・あれば良い）、確かめ方（解析・試験・検査・見て判定）、出どころ",
          "item": "requirement"
        }
      ]
    },
    {
      "id": "concept-study",
      "name": "コンセプト検討",
      "form": "文書",
      "uses": [
        "requirement-list"
      ],
      "outline": [
        {
          "heading": "方式の案",
          "describe": "機構の方式と全体の構成の案。一案ずつ、仕組み、主要な寸法の概算、長所と短所、使う技術の成熟度",
          "item": "concept"
        },
        {
          "heading": "外装の方向",
          "describe": "外装の案。一案ずつ、シルエット・比率・キーライン・色と素材と仕上げの方向と、それを示す絵",
          "item": "design-theme"
        },
        {
          "heading": "評価",
          "describe": "案ごとに要求に対する点数と重み、外装と機構の組み合わせで成り立つか"
        },
        {
          "heading": "選んだ案",
          "describe": "選んだ方式と外装の組み合わせ、理由、捨てた案から残す考え"
        }
      ]
    },
    {
      "id": "hard-points",
      "name": "ハードポイント",
      "form": "表",
      "uses": [
        "concept-study"
      ],
      "outline": [
        {
          "heading": "ハードポイント",
          "describe": "動かせない寸法・位置・角度。値と単位、許す幅、機構と外装のどちらが決めたか、根拠の要求",
          "item": "hard-point"
        }
      ]
    },
    {
      "id": "risk-register",
      "name": "リスク一覧",
      "form": "表",
      "uses": [
        "concept-study"
      ],
      "outline": [
        {
          "heading": "リスク",
          "describe": "技術・調達・法規・日程のリスク。起きること、影響、起きやすさ、先に潰す手と期限、担当",
          "item": "risk"
        }
      ]
    },
    {
      "id": "architecture",
      "name": "アーキテクチャ",
      "form": "図",
      "uses": [
        "concept-study",
        "hard-points"
      ],
      "view": {
        "as": "graph",
        "nodes": [
          "subsystem"
        ],
        "edges": [
          "interface"
        ]
      },
      "outline": [
        {
          "heading": "部分",
          "describe": "製品を分けた部分（サブシステム）。役割、受け持つ要求、機構か外装か",
          "item": "subsystem"
        },
        {
          "heading": "つなぎ目",
          "describe": "部分と部分のつなぎ目。from・to の部分、伝えるもの（力・回転・位置・水・熱・信号）、固定のしかた、守る寸法",
          "item": "interface"
        }
      ]
    },
    {
      "id": "layout-model",
      "name": "配置の3Dモデル",
      "form": "CAD",
      "uses": [
        "hard-points",
        "architecture"
      ],
      "outline": [
        {
          "heading": "配置の寸法",
          "describe": "ハードポイントと主要寸法を、名前の付いた寸法として持つ。ハードポイントから来た寸法はその ID を引く",
          "item": "parameter"
        },
        {
          "heading": "配置の形",
          "describe": "部分ごとの占める空間を、簡単な形で寸法から作る。可動部は動く範囲も形にする",
          "item": "envelope"
        }
      ]
    },
    {
      "id": "budget",
      "name": "割付け",
      "form": "表",
      "uses": [
        "requirement-list",
        "architecture"
      ],
      "outline": [
        {
          "heading": "割付け",
          "describe": "質量・原価・公差・消費（電力・トルクなど）を部分に割り付けた行。割り付けた値、合計と目標、余裕、公差は積み上げの方式（最悪値・統計）",
          "item": "budget"
        }
      ]
    },
    {
      "id": "ebom",
      "name": "部品表（設計）",
      "form": "表",
      "uses": [
        "architecture"
      ],
      "outline": [
        {
          "heading": "部品",
          "describe": "一行に一つの部品。部品番号、名前、属する部分、数量、材料、内製・購入・標準品、質量の見込み",
          "item": "part"
        }
      ]
    },
    {
      "id": "dfmea",
      "name": "設計FMEA",
      "form": "表",
      "uses": [
        "architecture",
        "ebom"
      ],
      "outline": [
        {
          "heading": "故障モード",
          "describe": "部分・部品ごとの故障のしかた、影響、原因、深刻さ・起きやすさ・見つけやすさの点、対策と期限",
          "item": "failure-mode"
        }
      ]
    },
    {
      "id": "sourcing-plan",
      "name": "工法と調達の方針",
      "form": "表",
      "uses": [
        "ebom"
      ],
      "outline": [
        {
          "heading": "方針",
          "describe": "部品ごとの工法（プレス・射出・切削・鍛造・鋳造など）、内製か外注か、取引先の候補、型や長納期の品と発注の目安",
          "item": "sourcing-decision"
        }
      ]
    },
    {
      "id": "detail-model",
      "name": "詳細の3Dモデル",
      "form": "CAD",
      "uses": [
        "layout-model",
        "ebom"
      ],
      "outline": [
        {
          "heading": "部品の寸法",
          "describe": "部品の形を決める名前の付いた寸法。配置の寸法から引き継ぐものはその ID を引く",
          "item": "detail-parameter"
        },
        {
          "heading": "部品の形",
          "describe": "部品の詳細な形（肉厚・リブ・抜き勾配・面取り・結合部）。部品表の部品を引く",
          "item": "body"
        }
      ]
    },
    {
      "id": "drawings",
      "name": "図面",
      "form": "文書",
      "uses": [
        "detail-model",
        "key-characteristics"
      ],
      "outline": [
        {
          "heading": "図面",
          "describe": "部品・組立ごとの図面。図番、版、寸法と公差、幾何公差、表面と仕上げ、材料と熱処理、重要特性の印。3Dモデルに製品製造情報を持たせるときはその置き場",
          "item": "drawing"
        }
      ]
    },
    {
      "id": "key-characteristics",
      "name": "重要特性",
      "form": "表",
      "uses": [
        "detail-model",
        "dfmea"
      ],
      "outline": [
        {
          "heading": "重要特性",
          "describe": "安全・機能・組立・外観に効く寸法や性状。値と公差、根拠の要求、測り方",
          "item": "key-characteristic"
        }
      ]
    },
    {
      "id": "analysis-report",
      "name": "解析報告",
      "form": "文書",
      "uses": [
        "detail-model",
        "requirement-list"
      ],
      "outline": [
        {
          "heading": "解析",
          "describe": "一件ずつ、確かめる要求、モデルの版、条件（荷重・拘束・材料・メッシュ・時間）、結果の数値と図、判定、既知解との照合と誤差",
          "item": "analysis"
        },
        {
          "heading": "残る課題",
          "describe": "解析で確かめきれない点と、試作の試験に回すこと"
        }
      ]
    },
    {
      "id": "appearance-review",
      "name": "面品質と意匠の確認",
      "form": "文書",
      "uses": [
        "detail-model",
        "concept-study"
      ],
      "outline": [
        {
          "heading": "確認",
          "describe": "一件ずつ、見た面と方法（ゼブラ・曲率・ハイライト・レンダリング・シルエット比較）、モデルの版、画像、判定と判定者",
          "item": "appearance"
        },
        {
          "heading": "隙間と面差",
          "describe": "外装の部品どうしの隙間と面差の目標と、確かめた値"
        }
      ]
    },
    {
      "id": "dfm-review",
      "name": "製造性の確認",
      "form": "表",
      "uses": [
        "detail-model",
        "sourcing-plan"
      ],
      "outline": [
        {
          "heading": "指摘",
          "describe": "工法の条件（抜き勾配・肉厚・アンダーカット・工具の入り・組立順）に対する指摘、出した人、直し方と結果",
          "item": "dfm-finding"
        }
      ]
    },
    {
      "id": "dv-plan",
      "name": "設計検証の計画",
      "form": "表",
      "uses": [
        "requirement-list",
        "analysis-report"
      ],
      "outline": [
        {
          "heading": "試験",
          "describe": "要求ごとの試験。方法、試料の数と版、判定の基準、設備、日程",
          "item": "test"
        }
      ]
    },
    {
      "id": "dv-report",
      "name": "設計検証の報告",
      "form": "文書",
      "uses": [
        "dv-plan"
      ],
      "outline": [
        {
          "heading": "結果",
          "describe": "試験ごとの結果。測った値、判定、解析との差と理由、写真",
          "item": "test-result"
        },
        {
          "heading": "不具合と対策",
          "describe": "見つかった不具合、原因、設計の変更、変更後の確かめ"
        },
        {
          "heading": "量産型への判断",
          "describe": "量産の型に進んでよいかの判断と、条件付きの場合の残り"
        }
      ]
    },
    {
      "id": "quote-comparison",
      "name": "見積と取引先",
      "form": "表",
      "uses": [
        "sourcing-plan",
        "drawings"
      ],
      "outline": [
        {
          "heading": "取引先",
          "describe": "候補の取引先。工場の監査の結果、品質の仕組み、生産能力",
          "item": "supplier"
        },
        {
          "heading": "見積",
          "describe": "部品ごとの見積。取引先、単価、型の費用、納期、比べた結果と決めた取引先",
          "item": "quote"
        }
      ]
    },
    {
      "id": "part-approval",
      "name": "部品の承認",
      "form": "表",
      "uses": [
        "quote-comparison",
