ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [ReferenceView]'),'2;1');
FILE_NAME('f35-foreign.ifc','2026-10-24T12:00:00',('F35'),(''),'hand-written','another program','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Written by hand for F35 (R2c-4b): what another program might export. Lengths in metres,
   angles in degrees, no EP_* data. */
#1=IFCPROJECT('0project______________',$,'Foreign house',$,$,$,$,(#10),#2);
#2=IFCUNITASSIGNMENT((#3,#4,#5,#6));
#3=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#4=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#5=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#6=IFCCONVERSIONBASEDUNIT(#7,.PLANEANGLEUNIT.,'DEGREE',#8);
#7=IFCDIMENSIONALEXPONENTS(0,0,0,0,0,0,0);
#8=IFCMEASUREWITHUNIT(IFCPLANEANGLEMEASURE(0.017453292519943295),#9);
#9=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#11,#12);
#11=IFCAXIS2PLACEMENT3D(#13,$,$);
#12=IFCDIRECTION((0.,1.));
#13=IFCCARTESIANPOINT((0.,0.,0.));
#14=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#10,$,.MODEL_VIEW.,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Axis','Model',*,*,*,*,#10,$,.GRAPH_VIEW.,$);
#16=IFCDIRECTION((0.,0.,1.));
#17=IFCDIRECTION((1.,0.,0.));
#18=IFCDIRECTION((0.,1.,0.));
#19=IFCDIRECTION((0.,-1.,0.));

/* Spatial structure: two storeys, the first at 3 m. */
#20=IFCSITE('0site_________________',$,'Site',$,$,#21,$,$,.ELEMENT.,$,$,12.5,$,$);
#21=IFCLOCALPLACEMENT($,#11);
#22=IFCBUILDING('0building_____________',$,'House',$,$,#23,$,$,.ELEMENT.,$,$,$);
#23=IFCLOCALPLACEMENT(#21,#11);
#24=IFCBUILDINGSTOREY('0ground_______________',$,'Ground',$,$,#25,$,$,.ELEMENT.,0.);
#25=IFCLOCALPLACEMENT(#23,#11);
#26=IFCBUILDINGSTOREY('0first________________',$,'First',$,$,#27,$,$,.ELEMENT.,3.);
#27=IFCLOCALPLACEMENT(#23,#28);
#28=IFCAXIS2PLACEMENT3D(#29,$,$);
#29=IFCCARTESIANPOINT((0.,0.,3.));
#30=IFCRELAGGREGATES('0agg1_________________',$,$,$,#1,(#20));
#31=IFCRELAGGREGATES('0agg2_________________',$,$,$,#20,(#22));
#32=IFCRELAGGREGATES('0agg3_________________',$,$,$,#22,(#24,#26));

/* Materials and types. */
#40=IFCMATERIAL('Concrete',$,'Concrete');
#41=IFCMATERIAL('Brick',$,'Masonry');
#42=IFCMATERIAL('Steel',$,'Metal');
#43=IFCMATERIALLAYER(#40,0.2,$,$,$,$,$);
#44=IFCMATERIALLAYERSET((#43),'Basic 200',$);
#45=IFCWALLTYPE('0walltype_____________',$,'Basic 200',$,$,$,$,$,$,.STANDARD.);
#46=IFCRELASSOCIATESMATERIAL('0mat1_________________',$,$,$,(#45),#44);
#47=IFCMATERIALLAYERSET((#48),'Slab 200',$);
#48=IFCMATERIALLAYER(#40,0.2,$,$,$,$,$);
#49=IFCSLABTYPE('0slabtype_____________',$,'Slab 200',$,$,$,$,$,$,.FLOOR.);
#50=IFCRELASSOCIATESMATERIAL('0mat2_________________',$,$,$,(#49),#47);
#51=IFCRELDEFINESBYTYPE('0deftype1_____________',$,$,$,(#100,#300),#45);
#52=IFCRELDEFINESBYTYPE('0deftype2_____________',$,$,$,(#400),#49);
#53=IFCRELASSOCIATESMATERIAL('0mat3_________________',$,$,$,(#200),#41);
#54=IFCRELASSOCIATESMATERIAL('0mat4_________________',$,$,$,(#600),#42);

/* W1: 5.1 m along X to W2's far face (the join), a rectangle profile and an Axis curve. */
#100=IFCWALL('0w1___________________',$,'W1',$,$,#101,#102,$,.STANDARD.);
#101=IFCLOCALPLACEMENT(#25,#11);
#102=IFCPRODUCTDEFINITIONSHAPE($,$,(#103,#106));
#103=IFCSHAPEREPRESENTATION(#15,'Axis','Curve2D',(#104));
#104=IFCPOLYLINE((#105,#107));
#105=IFCCARTESIANPOINT((0.,0.));
#107=IFCCARTESIANPOINT((5.1,0.));
#106=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#108));
#108=IFCEXTRUDEDAREASOLID(#109,$,#16,2.8);
#109=IFCRECTANGLEPROFILEDEF(.AREA.,$,#110,5.1,0.2);
#110=IFCAXIS2PLACEMENT2D(#111,$);
#111=IFCCARTESIANPOINT((2.55,0.));
#112=IFCPROPERTYSET('0pset1________________',$,'Pset_WallCommon',$,(#113,#114));
#113=IFCPROPERTYSINGLEVALUE('IsExternal',$,IFCBOOLEAN(.T.),$);
#114=IFCPROPERTYSINGLEVALUE('AcousticRating',$,IFCLABEL('R45'),$);
#115=IFCRELDEFINESBYPROPERTIES('0rdp1_________________',$,$,$,(#100),#112);
#116=IFCPROPERTYSET('0pset2________________',$,'Vendor data',$,(#117));
#117=IFCPROPERTYSINGLEVALUE('Code',$,IFCLABEL('X-1'),$);
#118=IFCRELDEFINESBYPROPERTIES('0rdp2_________________',$,$,$,(#100),#116);

/* O1 in W1: a vertical rectangle swept through the wall (along -Y). */
#120=IFCOPENINGELEMENT('0o1___________________',$,'O1',$,$,#121,#122,$,.OPENING.);
#121=IFCLOCALPLACEMENT(#101,#11);
#122=IFCPRODUCTDEFINITIONSHAPE($,$,(#123));
#123=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#124));
#124=IFCEXTRUDEDAREASOLID(#125,#126,#16,0.3);
#125=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,1.,1.2);
#126=IFCAXIS2PLACEMENT3D(#127,#19,#17);
#127=IFCCARTESIANPOINT((2.,0.15,1.));
#128=IFCRELVOIDSELEMENT('0void1________________',$,$,$,#100,#120);

/* W2: along Y from W1's face to 4 m (the join), a closed polyline profile, brick, no type. */
#200=IFCWALL('0w2___________________',$,'W2',$,$,#201,#202,$,.STANDARD.);
#201=IFCLOCALPLACEMENT(#25,#203);
#203=IFCAXIS2PLACEMENT3D(#204,#16,#18);
#204=IFCCARTESIANPOINT((5.,0.,0.));
#202=IFCPRODUCTDEFINITIONSHAPE($,$,(#205));
#205=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#206));
#206=IFCEXTRUDEDAREASOLID(#207,$,#16,2.8);
#207=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#208);
#208=IFCPOLYLINE((#209,#210,#211,#212,#209));
#209=IFCCARTESIANPOINT((0.1,-0.1));
#210=IFCCARTESIANPOINT((4.,-0.1));
#211=IFCCARTESIANPOINT((4.,0.1));
#212=IFCCARTESIANPOINT((0.1,0.1));
#213=IFCRELCONNECTSPATHELEMENTS('0join1________________',$,$,$,$,#100,#200,(),(),.ATSTART.,.ATEND.);

/* D1 in W2: a door (outside the subset) and the opening it fills. */
#220=IFCOPENINGELEMENT('0o2___________________',$,'O2',$,$,#221,#222,$,.OPENING.);
#221=IFCLOCALPLACEMENT(#201,#11);
#222=IFCPRODUCTDEFINITIONSHAPE($,$,(#223));
#223=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#224));
#224=IFCEXTRUDEDAREASOLID(#225,$,#16,2.1);
#225=IFCRECTANGLEPROFILEDEF(.AREA.,$,#226,0.9,0.4);
#226=IFCAXIS2PLACEMENT2D(#227,$);
#227=IFCCARTESIANPOINT((1.45,0.));
#228=IFCRELVOIDSELEMENT('0void2________________',$,$,$,#200,#220);
#230=IFCDOOR('0d1___________________',$,'D1',$,$,#221,$,$,2.1,0.9,.DOOR.,.SINGLE_SWING_LEFT.,$);
#231=IFCRELFILLSELEMENT('0fill1________________',$,$,$,#220,#230);

/* S1: the first floor's slab, 5 × 4 m with a 1 m hole, top at 3 m. */
#400=IFCSLAB('0s1___________________',$,'S1',$,$,#401,#402,$,.FLOOR.);
#401=IFCLOCALPLACEMENT(#27,#403);
#403=IFCAXIS2PLACEMENT3D(#404,$,$);
#404=IFCCARTESIANPOINT((0.,0.,-0.2));
#402=IFCPRODUCTDEFINITIONSHAPE($,$,(#405));
#405=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#406));
#406=IFCEXTRUDEDAREASOLID(#407,$,#16,0.2);
#407=IFCARBITRARYPROFILEDEFWITHVOIDS(.AREA.,$,#408,(#409));
#408=IFCINDEXEDPOLYCURVE(#410,$,.F.);
#410=IFCCARTESIANPOINTLIST2D(((0.,0.),(5.,0.),(5.,4.),(0.,4.),(0.,0.)));
#409=IFCPOLYLINE((#411,#412,#413,#414,#411));
#411=IFCCARTESIANPOINT((1.,1.));
#412=IFCCARTESIANPOINT((1.,2.));
#413=IFCCARTESIANPOINT((2.,2.));
#414=IFCCARTESIANPOINT((2.,1.));
#420=IFCOPENINGELEMENT('0o3___________________',$,'O3',$,$,#421,#422,$,.OPENING.);
#421=IFCLOCALPLACEMENT(#401,#11);
#422=IFCPRODUCTDEFINITIONSHAPE($,$,(#423));
#423=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#424));
#424=IFCEXTRUDEDAREASOLID(#425,#426,#16,0.22);
#425=IFCRECTANGLEPROFILEDEF(.AREA.,$,#427,1.,1.);
#426=IFCAXIS2PLACEMENT3D(#428,$,$);
#428=IFCCARTESIANPOINT((0.,0.,-0.01));
#427=IFCAXIS2PLACEMENT2D(#429,$);
#429=IFCCARTESIANPOINT((3.5,2.5));
#430=IFCRELVOIDSELEMENT('0void3________________',$,$,$,#400,#420);

/* A grid and C1 placed at A/1 with IfcGridPlacement. */
#500=IFCGRID('0grid_________________',$,'Grid',$,$,#501,$,(#502),(#503),$,.RECTANGULAR.);
#501=IFCLOCALPLACEMENT(#25,#11);
#502=IFCGRIDAXIS('A',#504,.T.);
#503=IFCGRIDAXIS('1',#505,.T.);
#504=IFCPOLYLINE((#506,#507));
#505=IFCPOLYLINE((#508,#509));
#506=IFCCARTESIANPOINT((1.,-1.));
#507=IFCCARTESIANPOINT((1.,5.));
#508=IFCCARTESIANPOINT((-1.,2.));
#509=IFCCARTESIANPOINT((6.,2.));
#510=IFCCOLUMN('0c1___________________',$,'C1',$,$,#511,#512,$,.COLUMN.);
#511=IFCGRIDPLACEMENT(#513,$);
#513=IFCVIRTUALGRIDINTERSECTION((#502,#503),(0.,0.,0.));
#512=IFCPRODUCTDEFINITIONSHAPE($,$,(#514));
#514=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#515));
#515=IFCEXTRUDEDAREASOLID(#516,$,#16,2.8);
#516=IFCISHAPEPROFILEDEF(.AREA.,'HEA 200',$,0.2,0.19,0.0065,0.01,$,$,$);
#517=IFCRELASSOCIATESMATERIAL('0mat5_________________',$,$,$,(#510),#42);

/* B1: a 300 × 500 beam along X at y = 3 m, its top at 2.8 m. */
#600=IFCBEAM('0b1___________________',$,'B1',$,$,#601,#602,$,.BEAM.);
#601=IFCLOCALPLACEMENT(#25,#603);
#603=IFCAXIS2PLACEMENT3D(#604,#17,#18);
#604=IFCCARTESIANPOINT((0.,3.,2.55));
#602=IFCPRODUCTDEFINITIONSHAPE($,$,(#605));
#605=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#606));
#606=IFCEXTRUDEDAREASOLID(#607,$,#16,5.);
#607=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,0.3,0.5);

/* R1: a flat roof, underside at 6 m. */
#700=IFCROOF('0r1___________________',$,'R1',$,$,#701,#702,$,.FLAT_ROOF.);
#701=IFCLOCALPLACEMENT(#27,#703);
#703=IFCAXIS2PLACEMENT3D(#704,$,$);
#704=IFCCARTESIANPOINT((0.,0.,3.));
#702=IFCPRODUCTDEFINITIONSHAPE($,$,(#705));
#705=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#706));
#706=IFCEXTRUDEDAREASOLID(#707,$,#16,0.25);
#707=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#708);
#708=IFCPOLYLINE((#105,#712,#713,#714,#105));
#712=IFCCARTESIANPOINT((5.,0.));
#713=IFCCARTESIANPOINT((5.,4.));
#714=IFCCARTESIANPOINT((0.,4.));
#709=IFCCARTESIANPOINT((5.,0.,0.));
#710=IFCCARTESIANPOINT((5.,4.,0.));

/* W3 on the first storey, cut by the roof's underside; W4 cut by a plane no roof has. */
#300=IFCWALL('0w3___________________',$,'W3',$,$,#301,#302,$,.STANDARD.);
#301=IFCLOCALPLACEMENT(#27,#303);
#303=IFCAXIS2PLACEMENT3D(#304,$,$);
#304=IFCCARTESIANPOINT((0.,3.8,0.));
#302=IFCPRODUCTDEFINITIONSHAPE($,$,(#305));
#305=IFCSHAPEREPRESENTATION(#14,'Body','Clipping',(#306));
#306=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#307,#308);
#307=IFCEXTRUDEDAREASOLID(#109,$,#16,4.);
#308=IFCHALFSPACESOLID(#309,.F.);
#309=IFCPLANE(#310);
#310=IFCAXIS2PLACEMENT3D(#311,$,$);
#311=IFCCARTESIANPOINT((0.,0.,3.));
#320=IFCWALL('0w4___________________',$,'W4',$,$,#321,#322,$,.STANDARD.);
#321=IFCLOCALPLACEMENT(#27,#323);
#323=IFCAXIS2PLACEMENT3D(#324,$,$);
#324=IFCCARTESIANPOINT((0.,2.,0.));
#322=IFCPRODUCTDEFINITIONSHAPE($,$,(#325));
#325=IFCSHAPEREPRESENTATION(#14,'Body','Clipping',(#326));
#326=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#307,#327);
#327=IFCHALFSPACESOLID(#328,.F.);
#328=IFCPLANE(#329);
#329=IFCAXIS2PLACEMENT3D(#311,#330,#17);
#330=IFCDIRECTION((0.,-0.5,1.));

/* Furniture as a faceted solid, and a proxy with no part reference. */
#800=IFCFURNISHINGELEMENT('0chair________________',$,'Chair',$,$,#801,#802,$);
#801=IFCLOCALPLACEMENT(#25,#11);
#802=IFCPRODUCTDEFINITIONSHAPE($,$,(#803));
#803=IFCSHAPEREPRESENTATION(#14,'Body','Brep',(#804));
#804=IFCFACETEDBREP(#805);
#805=IFCCLOSEDSHELL((#806));
#806=IFCFACE((#807));
#807=IFCFACEOUTERBOUND(#808,.T.);
#808=IFCPOLYLOOP((#13,#709,#710));
#810=IFCBUILDINGELEMENTPROXY('0proxy________________',$,'Box',$,$,#801,#802,$,.NOTDEFINED.);

/* SP1: a room. */
#900=IFCSPACE('0sp1__________________',$,'101','Office',$,#901,#902,'Office',.ELEMENT.,.INTERNAL.,$);
#901=IFCLOCALPLACEMENT(#25,#11);
#902=IFCPRODUCTDEFINITIONSHAPE($,$,(#903));
#903=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#904));
#904=IFCEXTRUDEDAREASOLID(#905,$,#16,2.8);
#905=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#906);
#906=IFCINDEXEDPOLYCURVE(#907,(IFCLINEINDEX((1,2,3,4,1))),.F.);
#907=IFCCARTESIANPOINTLIST2D(((0.2,0.2),(4.8,0.2),(4.8,2.8),(0.2,2.8)));
#910=IFCRELAGGREGATES('0agg4_________________',$,$,$,#24,(#900));

#950=IFCRELCONTAINEDINSPATIALSTRUCTURE('0in1__________________',$,$,$,(#100,#200,#230,#510,#600,#800,#810,#500),#24);
#951=IFCRELCONTAINEDINSPATIALSTRUCTURE('0in2__________________',$,$,$,(#400,#700,#300,#320),#26);
ENDSEC;
END-ISO-10303-21;
