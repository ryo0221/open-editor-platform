ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [ReferenceView]'),'2;1');
FILE_NAME('f53-foreign-ramps.ifc','2026-11-08T12:00:00',('F53'),(''),'hand-written','another program','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Written for F53 (FU2, docs/cad/bim-followups.md): ramps as another program might export
   them, with no EP_* data. Lengths in metres. A ramp with no shape of its own made of two
   flights (a spiral and a straight one), a ramp with its own faceted body, and a sloped
   slab (a faceted B-rep) with an opening. */
#1=IFCPROJECT('0project______________',$,'Foreign car park',$,$,$,$,(#10),#2);
#2=IFCUNITASSIGNMENT((#3,#4,#5,#6));
#3=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#4=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#5=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#6=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#11,#12);
#11=IFCAXIS2PLACEMENT3D(#13,$,$);
#12=IFCDIRECTION((0.,1.));
#13=IFCCARTESIANPOINT((0.,0.,0.));
#14=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#10,$,.MODEL_VIEW.,$);
#16=IFCDIRECTION((0.,0.,1.));
#17=IFCDIRECTION((1.,0.,0.));

/* Spatial structure: two storeys, the first at 3 m. */
#20=IFCSITE('0site_________________',$,'Site',$,$,#21,$,$,.ELEMENT.,$,$,$,$,$);
#21=IFCLOCALPLACEMENT($,#11);
#22=IFCBUILDING('0building_____________',$,'Car park',$,$,#23,$,$,.ELEMENT.,$,$,$);
#23=IFCLOCALPLACEMENT(#21,#11);
#24=IFCBUILDINGSTOREY('0ground_______________',$,'Ground',$,$,#25,$,$,.ELEMENT.,0.);
#25=IFCLOCALPLACEMENT(#23,#11);
#26=IFCBUILDINGSTOREY('0first________________',$,'First',$,$,#27,$,$,.ELEMENT.,3.);
#27=IFCLOCALPLACEMENT(#23,#28);
#28=IFCAXIS2PLACEMENT3D(#29,$,$);
#29=IFCCARTESIANPOINT((0.,0.,3.));
#30=IFCRELAGGREGATES('0agg1_________________',$,$,$,#1,(#20));
#31=IFCRELAGGREGATES('0agg2_________________',$,$,$,#20,(#22));
#32=IFCRELAGGREGATES('0agg3_________________',$,$,$,#22,(#24,#26));

/* Materials: the flights carry a 250 mm layer set, the car park ramp a plain material. */
#40=IFCMATERIAL('Concrete',$,'Concrete');
#41=IFCMATERIALLAYER(#40,0.25,$,$,$,$,$);
#42=IFCMATERIALLAYERSET((#41),'Ramp 250',$);
#43=IFCRELASSOCIATESMATERIAL('0mat1_________________',$,$,$,(#110,#120),#42);
#44=IFCRELASSOCIATESMATERIAL('0mat2_________________',$,$,$,(#200),#40);

/* A ramp with no shape of its own, at (10, 5) on the ground storey, made of two flights. */
#100=IFCRAMP('0ramp_________________',$,'Ramp A',$,$,#101,$,$,.SPIRAL_RAMP.);
#101=IFCLOCALPLACEMENT(#25,#102);
#102=IFCAXIS2PLACEMENT3D(#103,$,$);
#103=IFCCARTESIANPOINT((10.,5.,0.));
#104=IFCRELAGGREGATES('0agg4_________________',$,$,$,#100,(#110,#120));
#110=IFCRAMPFLIGHT('0flightspiral_________',$,'Spiral flight',$,$,#111,#112,$,.SPIRAL.);
#111=IFCLOCALPLACEMENT(#101,#11);
#112=IFCPRODUCTDEFINITIONSHAPE($,$,(#113));
#113=IFCSHAPEREPRESENTATION(#14,'Body','Brep',(#2200));
/* The straight flight, 8 m east of the axis, turned 90 degrees. */
#120=IFCRAMPFLIGHT('0flightstraight_______',$,'Straight flight',$,$,#121,#124,$,.STRAIGHT.);
#121=IFCLOCALPLACEMENT(#101,#122);
#122=IFCAXIS2PLACEMENT3D(#123,#16,#18);
#123=IFCCARTESIANPOINT((8.,0.,0.));
#18=IFCDIRECTION((0.,1.,0.));
#124=IFCPRODUCTDEFINITIONSHAPE($,$,(#125));
#125=IFCSHAPEREPRESENTATION(#14,'Body','Tessellation',(#2926));

/* A ramp with its own body, at (-10, 0) on the first storey. */
#200=IFCRAMP('0ramppark_____________',$,'Car park ramp',$,$,#201,#204,$,.SPIRAL_RAMP.);
#201=IFCLOCALPLACEMENT(#27,#202);
#202=IFCAXIS2PLACEMENT3D(#203,$,$);
#203=IFCCARTESIANPOINT((-10.,0.,0.));
#204=IFCPRODUCTDEFINITIONSHAPE($,$,(#205));
#205=IFCSHAPEREPRESENTATION(#14,'Body','Tessellation',(#2924));
/* A sloped landing of another program at (30, 0) on the ground storey, with an opening near
   its high end that reaches only through the slab there. */
#400=IFCSLAB('0landing______________',$,'Sloped landing',$,$,#401,#402,$,.FLOOR.);
#401=IFCLOCALPLACEMENT(#25,#404);
#404=IFCAXIS2PLACEMENT3D(#405,$,$);
#405=IFCCARTESIANPOINT((30.,0.,0.));
#402=IFCPRODUCTDEFINITIONSHAPE($,$,(#403));
#403=IFCSHAPEREPRESENTATION(#14,'Body','Brep',(#2960));
#410=IFCOPENINGELEMENT('0landingopening_______',$,'Landing opening',$,$,#411,#412,$,.OPENING.);
#411=IFCLOCALPLACEMENT(#401,#11);
#412=IFCPRODUCTDEFINITIONSHAPE($,$,(#413));
#413=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#2970));
#414=IFCRELVOIDSELEMENT('0voids1_______________',$,$,$,#400,#410);
/* An opening through the straight flight, which is read as a sloped slab. */
#420=IFCOPENINGELEMENT('0flightopening________',$,'Flight opening',$,$,#421,#422,$,.OPENING.);
#421=IFCLOCALPLACEMENT(#121,#11);
#422=IFCPRODUCTDEFINITIONSHAPE($,$,(#423));
#423=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#2978));
#424=IFCRELVOIDSELEMENT('0voids2_______________',$,$,$,#120,#420);
#300=IFCRELCONTAINEDINSPATIALSTRUCTURE('0cont1________________',$,$,$,(#100,#400),#24);
#301=IFCRELCONTAINEDINSPATIALSTRUCTURE('0cont2________________',$,$,$,(#200),#26);

/* The spiral flight's body: a faceted B-rep, 54 steps round, its corners shared. */
#1001=IFCCARTESIANPOINT((2.,0.,0.));
#1002=IFCCARTESIANPOINT((2.,0.,-0.25));
#1003=IFCCARTESIANPOINT((5.,0.,0.));
#1004=IFCCARTESIANPOINT((5.,0.,-0.25));
